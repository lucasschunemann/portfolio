---
import '@fontsource-variable/mona-sans/standard.css';
import '@fontsource-variable/mona-sans/standard-italic.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Transition from '../components/Transition.astro';
import Loader from '../components/Loader.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'case' | 'articles' | 'article' | '404';
  loader?: boolean;
  themeColor?: string;
}

const { title, description = site.description, page, loader = false, themeColor = '#efeee8' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Product designer, UX/UI`;
---

<!doctype html>
<html lang="pt-BR" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ loader }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var pt = sessionStorage.getItem('pt');
          if (pt) {
            var o = JSON.parse(pt);
            d.classList.add('is-entering');
            d.style.setProperty('--pt-color', o.color);
            d.style.setProperty('--pt-fg', o.fg);
          } else if (
            loader &&
            !location.hash &&
            !sessionStorage.getItem('seen') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            d.classList.add('is-loading');
          }
        } catch (e) {}
        setTimeout(function () {
          d.classList.add('is-ready');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    {loader && <Loader />}
    <Transition />
    <Cursor />
    <Header home={page === 'home'} current={page === 'articles' || page === 'article' ? 'Artigos' : undefined} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
