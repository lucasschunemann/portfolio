---
import '@fontsource-variable/host-grotesk/wght.css';
import '@fontsource-variable/host-grotesk/wght-italic.css';
import '@fontsource/fragment-mono/400.css';
import '../../brand/tokens.css';
import '../../brand/motion.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { altPath, content, htmlLang, langOf, ogLocale, ui } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  section?: 'obras' | 'textos' | 'sobre';
  /** false em páginas sem equivalente no outro idioma (404) */
  alternate?: boolean;
}

const lang = langOf(Astro.url.pathname);
const other = lang === 'pt' ? 'en' : 'pt';
const { site } = content(lang);
const { title, description = site.description, section, alternate = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${ui[lang].title}`;
const alt = altPath(Astro.url.pathname);
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const here = Astro.url.pathname;
const ptPath = lang === 'pt' ? here : alt;
const enPath = lang === 'en' ? here : alt;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:image" content={lang === 'en' ? '/og-en.jpg' : '/og.jpg'} />
    {alternate && (
      <>
        <link rel="alternate" hreflang="pt-BR" href={abs(ptPath)} />
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(ptPath)} />
      </>
    )}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#EEEAE2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // tema: segue o aparelho (e acompanha quando ele muda); "acesa" ou "apagada" só se a pessoa escolher no rodapé
      (function () {
        var dark = matchMedia('(prefers-color-scheme: dark)');
        var apply = function (doc) {
          var t = null;
          try {
            t = localStorage.getItem('tema');
          } catch (e) {}
          if (t !== 'acesa' && t !== 'apagada') t = dark.matches ? 'apagada' : 'acesa';
          doc.documentElement.dataset.luz = t;
          doc.documentElement.classList.add('js');
        };
        try {
          // chave antiga, gravada por cliques sem querer: todo mundo volta a seguir o aparelho
          localStorage.removeItem('luz');
        } catch (e) {}
        apply(document);
        dark.addEventListener('change', function () {
          apply(document);
        });
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#conteudo">{ui[lang].skip}</a>
    <Header section={section} lang={lang} alt={alt} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
