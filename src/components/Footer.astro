---
import Quiet from './Quiet.astro';
import { content, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].foot;
const { site } = content(lang);
const updated = new Intl.DateTimeFormat('pt-BR', {
  timeZone: 'America/Sao_Paulo',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(new Date())
  .replace(/\//g, '.');
---

<footer class="foot">
  <Quiet mode="rise" class="foot__bars" />
  <div class="colophon grid">
  <span>© 2026 {site.name}</span>
  <span class="mute">{t.set}</span>
  <span class="mute">{t.updated} <span class="mono">{updated}</span></span>
  <span class="colophon__end">
    <!-- os valores guardados continuam "acesa" e "apagada"; data-tema-labels só troca o que aparece -->
    <button type="button" class="link" data-tema data-tema-labels={t.lightModes.join('|')} aria-label={t.lightAria}>
      {t.light}: <span data-tema-label>{t.lightModes[0]}</span>
    </button>
    <a href="#top" class="link" data-top>{t.top}</a>
  </span>
  </div>
</footer>
