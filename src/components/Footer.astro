---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
import Roll from './Roll.astro';
import Scribble from './Scribble.astro';
const first = 'LUCAS'.split('');
const second = 'von'.split('');
---
<footer class="ft" id="contato" data-hdr-light>
  <div class="grid">
    <p class="lbl" style="grid-column: 1 / -1">(06) Contato</p>
    <h2 class="ft__title">
      <span class="d" data-split>Tem um projeto?</span>
      <span class="si" data-split>vamos conversar.</span>
    </h2>
    <div class="ft__mail">
      <a href={`mailto:${site.email}`} class="ft__email" data-cursor="Escrever" data-cursor-color="var(--yellow)" data-cursor-fg="var(--ink)">
        {site.email}
        <Scribble />
      </a>
      <button class="copy lbl" type="button" data-copy={site.email}>
        <span data-copy-label>Copiar e-mail</span>
      </button>
    </div>
  </div>

  <div class="ft__cols grid">
    <div class="ft__col">
      <p class="lbl">Redes</p>
      <a href={site.linkedin} target="_blank" rel="noopener"><Roll text="LinkedIn" /><Arrow dir="ne" /></a>
      <a href={site.instagram} target="_blank" rel="noopener"><Roll text="Instagram" /><Arrow dir="ne" /></a>
    </div>
    <div class="ft__col">
      <p class="lbl">Base</p>
      <p>{site.city}</p>
      <p class="ft__clock"><span data-clock>--:--:--</span> GMT-3</p>
    </div>
    <div class="ft__col">
      <p class="lbl">Situação</p>
      <p style="display:inline-flex;align-items:center;gap:10px"><span class="dot" style="background:var(--yellow)"></span>{site.status}</p>
    </div>
    <div class="ft__col">
      <p class="lbl">Índice</p>
      <a href="/#trabalho" data-label="Trabalho"><Roll text="Trabalho" /></a>
      <a href="/#sobre" data-label="Sobre"><Roll text="Sobre" /></a>
      <a href="/artigos/" data-label="Artigos"><Roll text="Artigos" /></a>
    </div>
  </div>

  <div class="ft__word" aria-hidden="true" data-wordmark data-fit="0.84" data-fit-max="0.3">
    <span class="d">{first.map((c) => <span>{c}</span>)}</span>
    <span class="si">{second.map((c) => <span>{c}</span>)}</span>
  </div>

  <div class="ft__base lbl">
    <span>© 2026 {site.name}</span>
    <span class="von"><em>von</em>: a partícula que liga um nome a um lugar.</span>
    <button type="button" data-top><Roll text="Voltar ao topo ↑" /></button>
  </div>
</footer>
