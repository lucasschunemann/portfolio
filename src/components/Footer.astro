---
import { site } from '../data/site';
const updated = new Intl.DateTimeFormat('pt-BR', {
  timeZone: 'America/Sao_Paulo',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(new Date())
  .replace(/\//g, '.');
---

<footer class="colophon grid">
  <span>© 2026 {site.name}</span>
  <span class="mute">Composto em Host Grotesk e Fragment Mono</span>
  <span class="mute">Atualizado em <span class="mono">{updated}</span></span>
  <span class="colophon__end">
    <button type="button" class="link" data-tema aria-label="Tema da página">
      Luz: <span data-tema-label>automática</span>
    </button>
    <a href="#top" class="link" data-top>Topo ↑</a>
  </span>
</footer>
