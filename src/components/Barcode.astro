---
const seed = 'LUCASVONHELDENSCHUNEMANNBLUMENAU2026';
const bars: { x: number; w: number }[] = [];
let x = 0;
for (let i = 0; i < 46; i++) {
  const c = seed.charCodeAt(i % seed.length);
  const w = 0.6 + ((c * 7 + i * 3) % 4) * 0.55;
  const gap = 0.7 + ((c * 5 + i) % 3) * 0.5;
  bars.push({ x, w });
  x += w + gap;
}
const width = x;
---
<div class="hero__barcode">
  <svg viewBox={`0 0 ${width.toFixed(2)} 30`} preserveAspectRatio="none" aria-hidden="true">
    {bars.map((b) => <rect x={b.x.toFixed(2)} y="0" width={b.w.toFixed(2)} height="30" fill="currentColor" />)}
  </svg>
  <p>(26) 9 5549 04 · 0000000001 8</p>
</div>
