---
interface Props { dir?: 'right' | 'down' | 'up' | 'ne' }
const { dir = 'right' } = Astro.props;
const rot = { right: 0, down: 90, up: -90, ne: -45 }[dir];
---
<svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true" style={`transform: rotate(${rot}deg)`}>
  <path d="M1 6h9.5M6.5 2 10.5 6l-4 4" stroke="currentColor" stroke-width="1.6" />
</svg>
