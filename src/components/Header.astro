---
import { site } from '../data/site';

interface Props {
  section?: 'obras' | 'textos' | 'sobre';
}
const { section } = Astro.props;
const nav = [
  { label: 'Obras', href: '/#obras', key: 'obras' },
  { label: 'Serviços', href: '/#servicos', key: 'servicos' },
  { label: 'Sobre', href: '/#sobre', key: 'sobre', hide: true },
  { label: 'Textos', href: '/artigos/', key: 'textos', hide: true },
];
---

<header class="top grid">
  <a href="/" class="top__name">{site.name}</a>
  <span class="top__role mute">{site.role}</span>
  <span class="top__place mute">
    Blumenau <span class="mono" data-clock aria-label="Horário em Blumenau">--<i>:</i>--</span>
  </span>
  <nav class="top__nav" aria-label="Principal">
    {nav.map((n) => (
      <a href={n.href} class:list={{ 'hide-s': n.hide }} aria-current={section === n.key ? 'page' : undefined}>
        {n.label}
      </a>
    ))}
    <a href="/#contato" class="top__cta"><i class="dot" aria-hidden="true"></i>Contato</a>
  </nav>
</header>
