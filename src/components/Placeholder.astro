---
// Lugar da imagem quando o trabalho não tem telas públicas.
interface Props {
  name: string;
  year: string;
}
const { name, year } = Astro.props;
---

<div class="vacant" role="img" aria-label={`${name}: imagens não públicas`}>
  <span class="mono">Coleção particular</span>
  <span class="mute">{name}, {year}. Produto em desenvolvimento, telas não públicas.</span>
</div>
