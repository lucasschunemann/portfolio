---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import { bio, clients, facts, mailto, pad, process, projects, services, site, whatsapp } from '../data/site';
import { getArticles } from '../data/articles';
import rio from '../assets/retratos/rio.jpg';
import copoPerto from '../assets/retratos/copo-perto.jpg';
import perfil from '../assets/retratos/perfil.jpg';
import copo from '../assets/retratos/copo.jpg';

const articles = await getArticles();
const featuredArticles = articles.filter((a) => a.data.featured);
const years = projects.flatMap((p) => p.when.match(/\d{4}/g) ?? []).sort();
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const onWall = projects.filter((p) => p.wall);
---

<Base>
  <!-- abertura -->
  <section class="intro grid">
    <figure class="portrait" data-r>
      <Image src={rio} alt="Lucas Schünemann sorrindo, encostado num guarda-corpo à beira de um rio" widths={[240, 480]} sizes="(max-width: 760px) 45vw, 15vw" loading="eager" />
      <Image src={copoPerto} alt="" class="portrait__alt" widths={[240, 480]} sizes="(max-width: 760px) 45vw, 15vw" loading="eager" />
    </figure>
    <h1 class="intro__text" data-r style="--d:80ms">
      Desenho produtos digitais e sites que as pessoas entendem de primeira.{' '}
      <span class="mute">
        Sou Lucas, product designer em Blumenau. Ajudo startups, SaaS e negócios a sair da ideia e chegar numa
        interface clara, pronta para desenvolvimento ou já publicada.
      </span>
    </h1>
    <div class="intro__meta" data-r style="--d:160ms">
      <a class="pill pill--solid" href={mailto()}>Iniciar um projeto →</a>
      <a class="pill" href="#obras">Ver obras</a>
      <span class="intro__status"><i class="dot" aria-hidden="true"></i>{site.status}</span>
    </div>
  </section>

  <!-- com quem -->
  <section class="clients grid" aria-label="Com quem já trabalhei" data-r>
    <p class="mono mute">Com quem já trabalhei</p>
    <ul>
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <!-- parede -->
  <section class="block" id="obras" aria-labelledby="obras-t">
    <header class="block__head grid" data-r>
      <h2 id="obras-t">Obras selecionadas</h2>
      <span class="mono mute">Nº 01—{pad(onWall.length)}</span>
      <span class="mute block__aside">{years[0]}—{years[years.length - 1]}</span>
    </header>
    <div class="wall grid">
      {onWall.map((p, i) => <Work p={p} n={i + 1} />)}
    </div>
  </section>

  <!-- serviços -->
  <section class="block" id="servicos" aria-labelledby="servicos-t">
    <header class="block__head grid" data-r>
      <h2 id="servicos-t">Serviços</h2>
      <span class="mute">O que posso fazer pelo seu projeto</span>
    </header>
    <ol class="services grid">
      {services.map((s, i) => (
        <li class="service" data-r style={`--d:${i * 80}ms`}>
          <span class="mono mute">{pad(i + 1)}</span>
          <h3>{s.title}</h3>
          <p class="mute">{s.text}</p>
          <dl class="service__meta">
            <div>
              <dt class="mono mute">Ideal para</dt>
              <dd>{s.fit}</dd>
            </div>
            <div>
              <dt class="mono mute">Veja</dt>
              <dd>
                {s.refs.map((slug, j) => (
                  <>
                    {j > 0 && ', '}
                    <a class="link link--line" href={`/obras/${slug}/`}>{bySlug.get(slug)!.name}</a>
                  </>
                ))}
              </dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <!-- como funciona -->
  <section class="block" aria-labelledby="processo-t">
    <header class="block__head grid" data-r>
      <h2 id="processo-t">Como funciona</h2>
      <span class="mute">Do primeiro e-mail à entrega</span>
    </header>
    <ol class="steps grid">
      {process.map((s, i) => (
        <li data-r style={`--d:${i * 80}ms`}>
          <span class="mono mute">{pad(i + 1)}</span>
          <h3>{s.title}</h3>
          <p class="mute">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- índice -->
  <section class="block" aria-labelledby="indice-t">
    <header class="block__head grid" data-r>
      <h2 id="indice-t">Índice</h2>
      <span class="mono mute">{pad(projects.length)} obras</span>
    </header>
    <ol class="rows rows--works" data-r>
      {projects.map((p, i) => (
        <li>
          <a class="row" href={`/obras/${p.slug}/`}>
            <span class="mono mute">Nº {pad(i + 1)}</span>
            <span class="row__t">{p.name}</span>
            <span class="mute">{p.service}</span>
            <span class="mute hide-s">{p.client}</span>
            <span class="mono mute">{p.year}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- sobre -->
  <section class="block" id="sobre" aria-labelledby="sobre-t">
    <header class="block__head grid" data-r>
      <h2 id="sobre-t">Sobre</h2>
    </header>
    <div class="diptych grid">
      <figure class="diptych__a" data-r>
        <Image src={perfil} alt="Lucas de perfil, olhando um rio, com morros e prédios ao fundo" widths={[480, 800, 1200]} sizes="(max-width: 760px) 50vw, 30vw" />
        <figcaption class="mono mute">Retrato, I</figcaption>
      </figure>
      <figure class="diptych__b" data-r style="--d:120ms">
        <Image src={copo} alt="Lucas de boné, bebendo de um copo, diante de casas em estilo enxaimel" widths={[480, 800]} sizes="(max-width: 760px) 50vw, 22vw" />
        <figcaption class="mono mute">Retrato, II</figcaption>
      </figure>
    </div>
    <div class="about grid">
      <div class="about__text" data-r>
        <p class="about__lead">{bio[0]}</p>
        {bio.slice(1).map((b) => <p>{b}</p>)}
      </div>
      <div class="about__side" data-r style="--d:120ms">
        <dl class="facts">
          {facts.map(([k, v]) => (
            <div>
              <dt class="mute">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- textos -->
  <section class="block" aria-labelledby="textos-t">
    <header class="block__head grid" data-r>
      <h2 id="textos-t">Textos</h2>
      <span class="mono mute">{pad(articles.length)} textos</span>
      <a class="link block__aside" href="/artigos/">Todos os textos →</a>
    </header>
    <ol class="rows rows--texts" data-r>
      {featuredArticles.map((a) => (
        <li>
          <a class="row" href={a.href}>
            <span class="mono mute">{a.dateLabel}</span>
            <span class="row__t">{a.data.title}</span>
            <span class="mute hide-s">{a.data.theme}</span>
            <span class="mono mute">{a.minutes} min</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- contato -->
  <section class="block contact" id="contato" aria-labelledby="contato-t">
    <header class="block__head grid" data-r>
      <h2 id="contato-t">Contato</h2>
      <span class="mute"><i class="dot" aria-hidden="true"></i>{site.status}</span>
    </header>
    <div class="grid">
      <div class="contact__body" data-r>
        <p class="contact__lead">
          Vamos tirar o seu projeto do papel.{' '}
          <span class="mute">
            Conte em poucas linhas o que você precisa, em que ponto está e qual é o prazo. Eu respondo com os próximos
            passos.
          </span>
        </p>
        <div class="contact__actions">
          <a class="pill pill--solid" href={mailto()}>Escrever um e-mail →</a>
          <a class="pill" href={whatsapp()} target="_blank" rel="noopener">Chamar no WhatsApp ↗</a>
          <button type="button" class="pill" data-copy={site.email} data-copy-label="E-mail copiado ✓">Copiar e-mail</button>
        </div>
        <p class="contact__links">
          <a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="link" href={site.instagram} target="_blank" rel="noopener">Instagram ↗</a>
          <span class="mute">{site.city} · GMT-3</span>
        </p>
      </div>
    </div>
  </section>
</Base>
