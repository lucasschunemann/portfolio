---
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import { bio, facts, pad, practice, projects, site } from '../data/site';
import { getArticles } from '../data/articles';

const articles = await getArticles();
const years = projects.flatMap((p) => p.when.match(/\d{4}/g) ?? []).sort();
---

<Base>
  <!-- abertura -->
  <section class="intro grid">
    <p class="intro__text" data-r>
      Sou product designer com foco em UX/UI, co-fundador e CPO da neth! e designer na Área Central.{' '}
      <span class="mute">
        Em paralelo, desenho plataformas de dados e sites para clientes B2B e B2C, do discovery à interface pronta
        para desenvolvimento.
      </span>
    </p>
    <div class="intro__meta" data-r style="--d:120ms">
      <span><i class="dot" aria-hidden="true"></i>{site.status}</span>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="mono mute">{site.coords}</span>
    </div>
  </section>

  <!-- parede -->
  <section class="block" id="obras" aria-labelledby="obras-t">
    <header class="block__head grid" data-r>
      <h2 id="obras-t">Obras selecionadas</h2>
      <span class="mono mute">Nº 01—{pad(projects.length)}</span>
      <span class="mute block__aside">{years[0]}—{years[years.length - 1]}</span>
    </header>
    <div class="wall grid">
      {projects.map((p, i) => <Work p={p} n={i + 1} />)}
    </div>
  </section>

  <!-- índice -->
  <section class="block" aria-labelledby="indice-t">
    <header class="block__head grid" data-r>
      <h2 id="indice-t">Índice</h2>
      <span class="mono mute">{pad(projects.length)} obras</span>
    </header>
    <ol class="rows rows--works" data-r>
      {projects.map((p, i) => (
        <li>
          <a class="row" href={`/obras/${p.slug}/`}>
            <span class="mono mute">Nº {pad(i + 1)}</span>
            <span class="row__t">{p.name}</span>
            <span class="mute">{p.service}</span>
            <span class="mute hide-s">{p.client}</span>
            <span class="mono mute">{p.year}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- textos -->
  <section class="block" aria-labelledby="textos-t">
    <header class="block__head grid" data-r>
      <h2 id="textos-t">Textos</h2>
      <span class="mono mute">{pad(articles.length)} textos</span>
      <a class="link block__aside" href="/artigos/">Todos os textos →</a>
    </header>
    <ol class="rows rows--texts" data-r>
      {articles.map((a) => (
        <li>
          <a class="row" href={a.href}>
            <span class="mono mute">{a.dateLabel}</span>
            <span class="row__t">{a.data.title}</span>
            <span class="mute hide-s">{a.data.theme}</span>
            <span class="mono mute">{a.minutes} min</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- sobre -->
  <section class="block" id="sobre" aria-labelledby="sobre-t">
    <header class="block__head grid" data-r>
      <h2 id="sobre-t">Sobre</h2>
    </header>
    <div class="about grid">
      <div class="about__text" data-r>
        <p class="about__lead">{bio[0]}</p>
        {bio.slice(1).map((b) => <p>{b}</p>)}
      </div>
      <div class="about__side" data-r style="--d:120ms">
        <dl class="facts">
          {facts.map(([k, v]) => (
            <div>
              <dt class="mute">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <p class="mute about__k">Prática</p>
        <ul class="practice">
          {practice.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- contato -->
  <section class="block contact" id="contato" aria-labelledby="contato-t">
    <header class="block__head grid" data-r>
      <h2 id="contato-t">Contato</h2>
    </header>
    <div class="grid">
      <div class="contact__body" data-r>
        <p class="contact__lead">
          Tem um produto, um sistema ou um site em mente? Escreva para{' '}
          <a class="link link--line" href={`mailto:${site.email}`}>{site.email}</a>
          <button type="button" class="copy mono mute" data-copy={site.email}>copiar</button>
        </p>
        <p class="contact__links">
          <a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="link" href={site.instagram} target="_blank" rel="noopener">Instagram ↗</a>
        </p>
      </div>
    </div>
  </section>
</Base>
