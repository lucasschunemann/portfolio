---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Poster from '../../components/Poster.astro';
import Shape from '../../components/Shape.astro';
import { pad, projects } from '../../data/site';
import type { Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, i, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  p: Project;
  i: number;
  next: Project;
}

const { p, i, next } = Astro.props;
const fg = (x: Project) => (x.ink === 'light' ? 'var(--white)' : 'var(--ink)');
const meta: [string, string, string?][] = [
  ['Cliente', p.client],
  ['Indústria', p.industry],
  ['Serviço', p.service],
  ['Quando', p.when],
  ['Ferramentas', p.tools],
  ['Link', p.link ? p.link.replace(/^https?:\/\//, '') : 'Não público', p.link],
];
const [cover, second] = p.images;
---

<Base page="case" title={p.name} description={p.summary} themeColor={p.color}>
  <article style={`--c:${p.color}; --cf:${fg(p)}`}>
    <header class="case-hero" {...(p.ink === 'light' ? { 'data-hdr-light': '' } : {})}>
      <div class="grid">
        <p class="case-hero__lbl lbl" data-intro-fade>
          <a href="/#trabalho" data-label="Trabalho"><Arrow dir="up" /> Todo o trabalho</a>
          <span>({pad(i + 1)}/{pad(projects.length)}) {p.type}</span>
        </p>
        <h1 class="case-hero__title d" style={`--len:${Math.max(p.name.length, 6)}`} data-intro-title data-fit="0.995" data-fit-max="0.24">{p.name}</h1>
        <p class="case-hero__sum lt" data-split>{p.summary}</p>
        <dl class="case-hero__meta" data-intro-fade>
          {meta.map(([k, v, href]) => (
            <div>
              <dt class="lbl">{k}</dt>
              <dd>{href ? <a href={href} target="_blank" rel="noopener">{v}</a> : v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <figure class="case-fig case-fig--cover">
      <div class="case-fig__frame">
        <div class="case-fig__media" data-img-reveal>
          {cover ? (
            <img src={cover.src} alt={cover.caption} width="1600" height="878" decoding="async" data-speed="0.12" />
          ) : (
            <Poster />
          )}
        </div>
      </div>
      {cover && (
        <figcaption>
          <span class="lbl">Fig. 01</span>
          <span>{cover.caption}</span>
        </figcaption>
      )}
    </figure>

    <section class="case-body grid">
      <p class="case-body__lbl lbl">(Contexto)</p>
      <div class="case-body__text">
        {p.body.map((t, j) => (j === 0 ? <p data-split>{t}</p> : <p data-reveal>{t}</p>))}
      </div>
    </section>

    {p.lists.map((l) => (
      <section class="case-list grid">
        <h2 class="lbl">{l.title}</h2>
        <ol data-reveal-list>
          {l.items.map((it) => <li>{it}</li>)}
        </ol>
      </section>
    ))}

    {second && (
      <figure class="case-fig case-fig--second">
        <div class="case-fig__frame">
          <div class="case-fig__media" data-img-reveal>
            <img src={second.src} alt={second.caption} width="1600" height="878" loading="lazy" decoding="async" data-speed="0.12" />
          </div>
        </div>
        <figcaption>
          <span class="lbl">Fig. 02</span>
          <span>{second.caption}</span>
        </figcaption>
      </figure>
    )}

    <a
      href={`/trabalho/${next.slug}/`}
      class="next"
      style={`--n:${next.color}; --nf:${fg(next)}`}
      data-label={next.name}
      data-color={next.color}
      data-fg={fg(next)}
      data-cursor="Próximo"
      data-cursor-color="var(--ink)"
      {...(next.ink === 'light' ? { 'data-hdr-light': '' } : {})}
    >
      <span class="next__top lbl">
        <span>Próximo caso</span>
        <span class="next__go">{next.service} <Arrow /></span>
      </span>
      <span class="next__name d" style={`--len:${Math.max(next.name.length, 6)}`} data-fit="0.82" data-fit-max="0.2">{next.name}</span>
      <Shape shape={next.shape} class="sh--paper" />
    </a>
  </article>
</Base>
