---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../data/articles';
import { pad } from '../../data/site';

const list = await getArticles();
---

<Base title="Textos" description="Textos de Lucas Schünemann sobre design, produto e processo criativo." section="textos">
  <section class="page-head grid">
    <p class="mono mute" data-r>Textos</p>
    <h1 data-r style="--d:60ms">Notas sobre design, produto e processo.</h1>
    <p class="mono mute page-head__aside" data-r style="--d:120ms">{pad(list.length)} textos</p>
  </section>

  <ol class="rows rows--archive" data-r style="--d:160ms">
    {list.map((a) => (
      <li>
        <a class="row" href={a.href}>
          <span class="mono mute">Nº {pad(a.n)}</span>
          <span class="row__stack">
            <span class="row__t">{a.data.title}</span>
            <span class="mute">{a.data.excerpt}</span>
          </span>
          <span class="mute hide-s">{a.data.theme}</span>
          <span class="mono mute">{a.dateLabel}</span>
        </a>
      </li>
    ))}
  </ol>
</Base>
