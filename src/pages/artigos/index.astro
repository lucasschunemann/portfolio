---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import Shape from '../../components/Shape.astro';
import { getArticles } from '../../data/articles';

const list = await getArticles();
const pad = (x: number) => String(x).padStart(2, '0');
---

<Base page="articles" title="Artigos" description="Textos de Lucas Schünemann sobre design, produto e processo criativo.">
  <section class="blog-hero grid">
    <p class="lbl blog-hero__lbl" data-intro-fade>(Artigos) — {pad(list.length)} textos</p>
    <h1 class="blog-hero__title">
      <span class="d" data-intro-title>Escritos</span>
      <span class="si" data-write>& ideias</span>
    </h1>
    <p class="blog-hero__aside" data-split>
      Notas sobre design, produto e processo: do frontend ao UX, de filosofias antigas a rituais de foco.
    </p>
  </section>

  <ol class="blog-list" data-blog-list>
    {list.map((a) => (
      <li>
        <a
          href={a.href}
          class="blog-row"
          style={`--abg:${a.tone.bg}; --afg:${a.tone.fg}; --amk:${a.tone.mark}`}
          data-label={a.data.display[0]}
          data-color={a.tone.bg}
          data-fg={a.tone.fg}
          data-preview={a.id}
          data-cursor="Ler"
          data-cursor-color={a.tone.bg}
          data-cursor-fg={a.tone.fg}
        >
          <span class="blog-row__n lbl">{pad(a.n)}</span>
          <span class="blog-row__title">
            <span class="d">{a.data.display[0]}</span>
            <span class="lt">{a.data.display[1]}</span>
          </span>
          <span class="blog-row__meta">
            <span class="lbl">{a.dateLabel}</span>
            <span class="blog-row__theme">{a.data.theme} · {a.minutes} min</span>
          </span>
          <span class="blog-row__go"><Shape shape={a.data.shape} /><Arrow /></span>
        </a>
      </li>
    ))}
  </ol>

  <div class="blog-preview" aria-hidden="true" data-blog-preview>
    {list.map((a) => (
      <div class="blog-preview__item" data-preview-item={a.id}>
        <ArticleCover shape={a.data.shape} tone={a.tone} n={a.n} theme={a.data.theme} date={a.dateLabel} minutes={a.minutes} mini />
      </div>
    ))}
  </div>
</Base>
