---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/Diagram.astro';
import Fig from '../../components/Fig.astro';
import { mailto, pad, projects, type Figure, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      p,
      n: i + 1,
      prev: projects[(i - 1 + projects.length) % projects.length],
      prevN: ((i - 1 + projects.length) % projects.length) + 1,
      next: projects[(i + 1) % projects.length],
      nextN: ((i + 1) % projects.length) + 1,
    },
  }));
}

interface Props {
  p: Project;
  n: number;
  prev: Project;
  prevN: number;
  next: Project;
  nextN: number;
}

const { p, n, prev, prevN, next, nextN } = Astro.props;
const [cover, ...rest] = p.images;

// Fig. 1 é a capa; as outras seguem a ordem em que aparecem na página.
const figs: Figure[] = [
  ...p.decisions.flatMap((d) => (d.fig ? [d.fig] : [])),
  ...(p.process?.figs ?? []),
  ...rest,
];
const fig = (f: Figure) => figs.indexOf(f) + 2;

const meta = (
  [
    ['Ano', p.when],
    ['Cliente', p.client],
    ['Indústria', p.industry],
    ['Disciplina', p.service],
    ['Papel', p.role],
    ['Duração', p.duration],
    ['Ferramentas', p.tools],
  ] as [string, string | undefined][]
).filter((m): m is [string, string] => !!m[1]);
const personal = p.client === 'Projeto pessoal';
---

<Base title={p.name} description={p.summary} section="obras">
  <article class="room">
    <header class="room__head grid">
      <p class="room__crumb mono mute" data-r>
        <a class="link" href="/#obras">Obras</a> / Nº {pad(n)}
      </p>
      <div class="room__title" data-r style="--d:60ms">
        <h1>{p.name}</h1>
        <p class="mute">{p.summary}</p>
        {p.link && (
          <a class="pill" href={p.link} target="_blank" rel="noopener">
            Ver {personal ? 'a galeria' : 'o site'} no ar ↗
          </a>
        )}
      </div>
      <dl class="room__meta" data-r style="--d:120ms">
        {meta.map(([k, v]) => (
          <div>
            <dt class="mute">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </header>

    <figure class="fig fig--full grid">
      <div class="fig__frame" transition:name={`obra-${p.slug}`}>
        {cover ? (
          <Image src={cover.src} alt={cover.caption} widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw" loading="eager" />
        ) : (
          <Diagram />
        )}
      </div>
      <figcaption class="fig__cap">
        <span class="mono mute">Fig. 1</span>
        <span class="mute">
          {cover ? cover.caption : 'Diagrama do motor de créditos. Produto em desenvolvimento; as telas não são públicas.'}
        </span>
      </figcaption>
    </figure>

    <section class="room__text grid">
      <p class="room__k mono mute" data-r>Desafio</p>
      <div class="prose" data-r>
        {p.challenge.map((t) => <p>{t}</p>)}
      </div>
    </section>

    {p.decisions.map((d, i) => (
      <>
        <section class="room__text grid">
          <p class="room__k mono mute" data-r>Decisão {pad(i + 1)}</p>
          <div class="prose" data-r>
            <h2>{d.title}</h2>
            <p>{d.text}</p>
          </div>
        </section>
        {d.fig && <Fig f={d.fig} n={fig(d.fig)} />}
      </>
    ))}

    {p.process && (
      <>
        <section class="room__text grid">
          <p class="room__k mono mute" data-r>Processo</p>
          <div class="prose" data-r>
            <p>{p.process.text}</p>
          </div>
        </section>
        {p.process.figs?.map((f) => <Fig f={f} n={fig(f)} />)}
      </>
    )}

    {p.result && (
      <section class="room__text grid">
        <p class="room__k mono mute" data-r>Resultado</p>
        <div class="prose" data-r>
          {p.result.map((t) => <p>{t}</p>)}
        </div>
      </section>
    )}

    {p.quote && (
      <section class="room__text grid">
        <p class="room__k mono mute" data-r>Depoimento</p>
        <blockquote class="quote" data-r>
          <p>“{p.quote.text}”</p>
          <footer class="mute">{p.quote.author}, {p.quote.role}</footer>
        </blockquote>
      </section>
    )}

    {p.retro && (
      <section class="room__text grid">
        <p class="room__k mono mute" data-r>Hoje eu faria diferente</p>
        <div class="prose" data-r>
          <p>{p.retro}</p>
        </div>
      </section>
    )}

    {rest.map((f) => <Fig f={f} n={fig(f)} />)}

    <section class="cta grid" data-r>
      <p class="room__k mono mute">{personal ? 'Contato' : 'Próximo passo'}</p>
      <div class="cta__body">
        <p class="cta__lead">
          {personal
            ? 'Quer algo fora do comum para a sua marca?'
            : `Precisa de ${p.service === 'Design system' ? 'um design system' : p.type === 'Web' ? 'um site assim' : 'um produto assim'}?`}{' '}
          <span class="mute">Conte o que você precisa e eu respondo com os próximos passos.</span>
        </p>
        <a class="pill pill--solid" href={mailto(`Projeto parecido com ${p.name}`)}>Iniciar um projeto →</a>
      </div>
    </section>

    <nav class="pager grid" aria-label="Outras obras">
      <a class="pager__prev" href={`/obras/${prev.slug}/`}>
        <span class="mono mute">← Nº {pad(prevN)}</span>
        <span>{prev.name}</span>
      </a>
      <a class="pager__next" href={`/obras/${next.slug}/`}>
        <span class="mono mute">Nº {pad(nextN)} →</span>
        <span>{next.name}</span>
      </a>
    </nav>
  </article>
</Base>
